# Copy this file to .env and fill in real values.
# Only variables starting with VITE_ are bundled into the browser.

# URL of the Prepwise backend API
VITE_API_URL=http://127.0.0.1:8000

# Supabase public keys — safe to expose in the browser.
# Security comes from Supabase RLS policies, not from hiding these values.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here
