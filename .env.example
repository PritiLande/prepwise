# Copy this file to .env and fill in real values.
# Never commit .env to git — it may contain secrets.

APP_NAME=Prepwise
DEBUG=False

# Maximum resume upload size (megabytes)
MAX_UPLOAD_MB=5

# Maximum characters kept from a resume before truncation
MAX_RESUME_CHARS=20000

# --- Groq / LLM ---
GROQ_API_KEY=your_groq_api_key_here
# Groq retires models often. If you get a model error, check the current list at
# console.groq.com/docs/models and change this line. No code change needed.
GROQ_MODEL=openai/gpt-oss-20b
# Maximum job-description characters sent to the LLM
MAX_JD_CHARS=8000
# Seconds before a Groq call times out
LLM_TIMEOUT_SECONDS=30
# Extra retries on bad LLM output (0 = no retries)
LLM_MAX_RETRIES=2
# Max tokens for LLM completion (reasoning + reply). Raise if you get empty responses.
LLM_MAX_TOKENS=8192

# --- Rate limiting ---
# Max calls to POST /analyze per IP per minute (protects Groq free-tier quota)
RATE_LIMIT_ANALYZE=5/minute

# --- TLS / certificate fix ---
# Set to true if your antivirus or corporate proxy (Avast, Zscaler, etc.)
# intercepts HTTPS and causes CERTIFICATE_VERIFY_FAILED errors.
# This tells Python to trust your OS certificate store instead of its own.
# Leave false (or omit) on cloud servers — they have standard certificates.
USE_SYSTEM_CERTS=false

# --- Future phases (leave blank for now) ---
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_anon_key_here
JWT_SECRET=your_jwt_secret_here
