# Copy this file to .env and fill in real values.
# Never commit .env to git — it may contain secrets.

APP_NAME=Prepwise
DEBUG=False

# Maximum resume upload size (megabytes)
MAX_UPLOAD_MB=5

# Maximum characters kept from a resume before truncation
MAX_RESUME_CHARS=20000

# --- Groq / LLM ---
GROQ_API_KEY=your_groq_api_key_here
# Groq retires models often. If you get a model error, check the current list at
# console.groq.com/docs/models and change this line. No code change needed.
GROQ_MODEL=openai/gpt-oss-20b
# Maximum job-description characters sent to the LLM
MAX_JD_CHARS=8000
# Seconds before a Groq call times out
LLM_TIMEOUT_SECONDS=30
# Extra retries on bad LLM output (0 = no retries)
LLM_MAX_RETRIES=2
# Max tokens for LLM completion output. Raise if you get empty/truncated responses.
LLM_MAX_TOKENS=8192
# Reasoning effort for gpt-oss models: low / medium / high
# "low" saves reasoning tokens for the JSON reply. Raise if quality is poor.
LLM_REASONING_EFFORT=low

# --- Rate limiting ---
# Max calls to POST /analyze per IP per minute (protects Groq free-tier quota)
RATE_LIMIT_ANALYZE=5/minute

# --- CORS ---
# Which browser origins may call this API (comma-separated for multiple).
# The Vite dev server runs on port 5173 by default.
# Never use * — that allows any website to call your API.
ALLOWED_ORIGINS=http://localhost:5173

# --- TLS / certificate fix ---
# Set to true if your antivirus or corporate proxy (Avast, Zscaler, etc.)
# intercepts HTTPS and causes CERTIFICATE_VERIFY_FAILED errors.
# This tells Python to trust your OS certificate store instead of its own.
# Leave false (or omit) on cloud servers — they have standard certificates.
USE_SYSTEM_CERTS=false

# --- Supabase / database ---
# Project URL: Supabase dashboard → Settings → General → Project URL
SUPABASE_URL=your_supabase_project_url_here
# API key: Supabase dashboard → Settings → API Keys → Publishable key
SUPABASE_KEY=your_supabase_publishable_key_here
# How long (seconds) to cache JWKS public keys in memory (3600 = 1 hour)
JWKS_CACHE_TTL_SECONDS=3600

# --- Frontend build args (used by docker-compose) ---
# These are the same as SUPABASE_URL/KEY but prefixed with VITE_ so
# Vite bakes them into the browser bundle at build time.
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key_here
